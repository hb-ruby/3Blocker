{
  "name": "3blocker",
  "version": "1.0.1",
  "private": true,
  "license": "MIT",
  "description": "Firefox extension that blocks adult websites. These scripts are for development only; the extension itself has no dependencies.",
  "scripts": {
    "test": "npm run test:unit && npm run lint && npm run test:firefox",
    "test:unit": "node -e \"globalThis.print = console.log; require('./tests/test_blocklist.js')\"",
    "lint": "web-ext lint --config dev/web-ext-config.mjs",
    "test:firefox": "node tests/firefox_e2e.js",
    "start": "web-ext run --config dev/web-ext-config.mjs",
    "build": "web-ext build --config dev/web-ext-config.mjs",
    "sign": "node --env-file=.env node_modules/web-ext/bin/web-ext.js sign --config dev/web-ext-config.mjs"
  },
  "devDependencies": {
    "puppeteer-core": "24.29.0",
    "web-ext": "10.7.0"
  }
}
