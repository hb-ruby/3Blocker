{
  "manifest_version": 3,
  "name": "3Blocker",
  "version": "1.0.0",
  "description": "Blocks adult websites and allows adding custom websites to a blocklist.",
  "browser_specific_settings": {
    "gecko": {
      "id": "3blocker@local-addon",
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "storage",
    "activeTab",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "3Blocker"
  },
  "background": {
    "scripts": ["background.js"]
  }
}
