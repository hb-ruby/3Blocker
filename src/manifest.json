{
  "manifest_version": 3,
  "name": "3Blocker",
  "version": "1.0.1",
  "description": "Blocks adult websites and allows adding custom websites to a blocklist.",
  "browser_specific_settings": {
    "gecko": {
      "id": "3blocker@hb-ruby",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "webRequest",
    "webRequestBlocking",
    "webNavigation",
    "alarms",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "3Blocker"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "scripts": [
      "background/blocklist-core.js",
      "background/db.js",
      "background/background.js"
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "lists/blocklist.txt",
        "blocked/blocked.html",
        "blocked/blocked.css",
        "blocked/blocked.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
